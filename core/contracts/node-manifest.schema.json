{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junglecomputing.dev/schemas/node-manifest.schema.json",
  "title": "Jungle Node Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "display_name", "node_type", "environment", "version", "capabilities", "telemetry", "status"],
  "properties": {
    "node_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "node_type": {
      "type": "string",
      "enum": ["authority", "application", "worker", "storage", "browser", "gateway", "hybrid"]
    },
    "environment": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "application_id": {"type": ["string", "null"]},
    "organisation_id": {"type": ["string", "null"]},
    "city_id": {"type": ["string", "null"]},
    "island_id": {"type": ["string", "null"]},
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "protocols": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "health_url": {"type": ["string", "null"], "format": "uri"},
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["otlp_enabled"],
      "properties": {
        "otlp_enabled": {"type": "boolean"},
        "otlp_endpoint": {"type": ["string", "null"]},
        "metrics_enabled": {"type": "boolean", "default": true},
        "traces_enabled": {"type": "boolean", "default": true},
        "logs_enabled": {"type": "boolean", "default": true}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_cores": {"type": ["number", "null"], "minimum": 0},
        "memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "gpu_model": {"type": ["string", "null"]},
        "gpu_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "storage_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "default": {}
    },
    "status": {
      "type": "string",
      "enum": ["starting", "healthy", "degraded", "critical", "draining", "offline"]
    },
    "registered_at": {"type": ["string", "null"], "format": "date-time"},
    "last_heartbeat_at": {"type": ["string", "null"], "format": "date-time"}
  }
}