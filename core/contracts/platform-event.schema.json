{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junglecomputing.dev/schemas/platform-event.schema.json",
  "title": "Jungle Platform Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "source", "actor", "subject", "correlation_id", "payload_version", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_name"],
      "properties": {
        "service_name": {"type": "string", "minLength": 1},
        "service_version": {"type": ["string", "null"]},
        "node_id": {"type": ["string", "null"]},
        "application_id": {"type": ["string", "null"]}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id"],
      "properties": {
        "actor_type": {"type": "string", "enum": ["user", "service", "agent", "system", "external"]},
        "actor_id": {"type": "string", "minLength": 1},
        "delegated_by": {"type": ["string", "null"]}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id"],
      "properties": {
        "subject_type": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1}
      }
    },
    "organisation_id": {"type": ["string", "null"]},
    "tenant_id": {"type": ["string", "null"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "span_id": {"type": ["string", "null"]},
    "severity": {"type": "string", "enum": ["info", "notice", "warning", "error", "critical"], "default": "info"},
    "payload_version": {"type": "integer", "minimum": 1},
    "payload": {"type": "object"},
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]},
      "default": {}
    }
  }
}