{
    "version": 2,
    "builds": [
        {
            "src": "*.html",
            "use": "@vercel/static"
        },
        {
            "src": "*.js",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "/JungleComputing6.html"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}